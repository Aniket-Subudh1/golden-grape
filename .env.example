# Local MongoDB replica set (docker compose, or a local `mongod --replSet rs0`)
DATABASE_URL=mongodb://localhost:27017/golden_grape?replicaSet=rs0&directConnection=true
# 32+ random characters: openssl rand -hex 32
PAYLOAD_SECRET=
# Public site URL. Also needed at build time (canonical/hreflang URLs in prerendered pages).
APP_URL=http://localhost:3000

# S3-compatible media storage (AWS S3, Cloudflare R2, Hetzner, MinIO). Leave empty to store uploads in ./media.
# The bucket stays private: files are served through the app at /api/media/file/...
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# AWS region (e.g. eu-central-1), or "auto" for R2
S3_REGION=auto

# SMTP. Leave SMTP_HOST empty to log e-mails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
MAIL_FROM=Golden Grape <hello@goldengrape.lu>
# Where contact and catering requests are sent
MAIL_STAFF_TO=
