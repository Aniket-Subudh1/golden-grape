{
  "name": "golden-grape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "gate": "npm run check && npm run test:int && npm run build && npm run test:e2e",
    "seed": "node --import tsx --env-file-if-exists=.env scripts/seed.mts",
    "import:catalogue": "node --import tsx --env-file-if-exists=.env scripts/import-catalogue.mts",
    "import:pos": "node --import tsx --env-file-if-exists=.env scripts/import-pos-products.mts",
    "rebuild-stock": "node --import tsx --env-file-if-exists=.env scripts/rebuild-stock.mts",
    "migrate:2026-11": "node --import tsx --env-file-if-exists=.env scripts/migrate-2026-11.mts",
    "migrate:2026-11-11": "node --import tsx --env-file-if-exists=.env scripts/migrate-2026-11-11.mts",
    "migrate:2026-11-12": "node --import tsx --env-file-if-exists=.env scripts/migrate-2026-11-12.mts",
    "migrate:2026-11-13": "node --import tsx --env-file-if-exists=.env scripts/migrate-2026-11-13.mts",
    "migrate:2026-11-14": "node --import tsx --env-file-if-exists=.env scripts/migrate-2026-11-14.mts",
    "generate:types": "node --import tsx ./node_modules/payload/bin.js generate:types --disable-transpile",
    "generate:importmap": "node --import tsx ./node_modules/payload/bin.js generate:importmap --disable-transpile",
    "payload": "node --import tsx ./node_modules/payload/bin.js",
    "deploy": "ssh root@goldengrape.devsomeware.com gg-deploy"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-pdf/renderer": "4.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "gsap": "3.15.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "papaparse": "5.7.0",
    "payload": "3.92.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "read-excel-file": "9.3.14",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
